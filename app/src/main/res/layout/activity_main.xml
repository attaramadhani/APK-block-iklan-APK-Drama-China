<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp">

        <!-- Kontainer Status Shield -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStatus"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="80dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#1E1E2E">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <!-- Glowing Ring Effect -->
                <View
                    android:id="@+id/statusRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ring_inactive" />

                <!-- Ikon Status Shield -->
                <ImageView
                    android:id="@+id/imgShield"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_lock"
                    app:tint="#808080" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Label Status -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Perlindungan Nonaktif"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatusDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Lalu lintas DNS Anda belum disaring. Iklan sistem dapat muncul."
            android:textColor="#A0A0B0"
            android:textSize="13sp" />

        <!-- Timer Waktu Koneksi -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:fontFamily="sans-serif-condensed"
            android:layout_gravity="center_horizontal" />

        <!-- Tombol Utama Toggle VPN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleVpn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Aktifkan AdBlocker"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#6200EE"
            app:cornerRadius="28dp"
            app:rippleColor="#80FFFFFF" />

        <!-- Stats Card: Iklan Diblokir vs Akses Diizinkan -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:weightSum="2">

                <!-- Blocked Stats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBlockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF5252"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Iklan Diblokir"
                        android:textColor="#A0A0B0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#2E2E3E" />

                <!-- Allowed Stats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAllowedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4CAF50"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Akses Diizinkan"
                        android:textColor="#A0A0B0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Tips Anti Bocor DNS Pribadi -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAntiLeakTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#232336">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Tips Penting: Cegah Iklan Bocor"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Jika beberapa iklan masih muncul di HP Xiaomi/Samsung/Oppo/Vivo, pastikan fitur 'DNS Pribadi (Private DNS)' di Pengaturan HP Anda diatur ke 'Mati' (Off). Jika aktif, Android akan mem-bypass VPN."
                    android:textColor="#D0D0E0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenDnsSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="end"
                    android:text="Buka Pengaturan DNS HP"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#6200EE"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Pengaturan Anti-Iklan -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Perlindungan"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Scope Mode -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cakupan Perlindungan:"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <RadioGroup
                    android:id="@+id/rgScopeMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbScopeGlobal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Semua Aplikasi (Global) - Sangat Direkomendasikan"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:buttonTint="#03DAC6" />

                    <RadioButton
                        android:id="@+id/rbScopeMelolo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hanya Melolo &amp; Layanan Terkait"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:buttonTint="#03DAC6" />
                </RadioGroup>

                <!-- Upstream DNS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upstream DNS (Lapisan Kedua):"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <RadioGroup
                    android:id="@+id/rgUpstreamDns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <RadioButton
                        android:id="@+id/rbDnsAdGuard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AdGuard DNS (Anti-Iklan Berlapis - Rekomendasi)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:buttonTint="#03DAC6" />

                    <RadioButton
                        android:id="@+id/rbDnsCloudflare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cloudflare Security (1.1.1.2)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:buttonTint="#03DAC6" />

                    <RadioButton
                        android:id="@+id/rbDnsGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Google DNS (8.8.8.8)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:buttonTint="#03DAC6" />
                </RadioGroup>

                <!-- Pengaturan AI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kecerdasan Filter:"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swVideoGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="🎬 Mode Gerbang Video (Rekomendasi) — di Melolo, tutup SEMUA domain kecuali server video &amp; konten. Aplikasi lain tidak terpengaruh."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:thumbTint="#FFC107" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAiAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="AI Otomatis — blokir domain baru yang dinilai AI sebagai iklan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:thumbTint="#03DAC6" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAggressive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Mode Agresif — blokir juga telemetri ByteDance &amp; domain mencurigakan (bisa membuat video gagal diputar)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:thumbTint="#FF6B6B" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Perubahan mode cakupan atau DNS aktif saat VPN dinyalakan ulang. Pengaturan AI langsung aktif."
                    android:textColor="#808090"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Asisten AI -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Asisten AI Pemblokir"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="AI Lokal (offline) menilai setiap domain: iklan, pelacak, atau server inti Melolo yang tidak boleh diblokir. AI Online (Gemini, opsional) memberi analisis kedua untuk domain yang belum dikenal. Hanya nama domain yang dikirim."
                    android:textColor="#D0D0E0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvAiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AI Lokal aktif"
                    android:textColor="#03DAC6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etGeminiKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="API key Gemini (opsional)"
                        android:textColorHint="#606070"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:backgroundTint="#03DAC6"
                        android:maxLines="1"
                        android:inputType="textPassword" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveGeminiKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Simpan"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#6200EE"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Buat API key gratis di aistudio.google.com/apikey"
                    android:textColor="#808090"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloudAnalyze"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Analisis Online"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#03DAC6"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearCloudAi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Reset AI Online"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#FF6B6B"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CardView untuk Log Intersept DNS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Log -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log Aktivitas DNS"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2E2E3E"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Container RecyclerView untuk log interaktif -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/tvNoLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Belum ada aktivitas DNS..."
                        android:textColor="#A0A0B0"
                        android:textSize="12sp"
                        android:visibility="visible" />
                </FrameLayout>

                <!-- Action Buttons Row at the bottom of the Log Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnalyzeLogs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Analisis AI"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#03DAC6"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyLogs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Salin Log"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#FFC107"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLogs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Hapus Log"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#FF6B6B"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CardView untuk Izinkan Domain Kustom (Whitelist) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCustomWhitelist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Izinkan Domain Kustom (Whitelist)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Input area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/etCustomWhitelistDomain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Masukkan nama domain (diizinkan)"
                        android:textColorHint="#606070"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:backgroundTint="#03DAC6"
                        android:maxLines="1"
                        android:inputType="textUri" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomWhitelistAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Tambah"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#03DAC6"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- List of custom domains -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Domain Diizinkan:"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvCustomWhitelistList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Belum ada domain kustom yang diizinkan."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <!-- Reset Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomWhitelistClear"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"
                    android:text="Hapus Semua"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CardView untuk Blokir Domain Kustom (Blacklist) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCustomBlacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E1E2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blokir Domain Kustom (Blacklist)"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Input area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/etCustomBlacklistDomain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Masukkan nama domain (diblokir)"
                        android:textColorHint="#606070"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:backgroundTint="#FF6B6B"
                        android:maxLines="1"
                        android:inputType="textUri" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCustomBlacklistAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Tambah"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#FF6B6B"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- List of custom domains -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Domain Diblokir:"
                    android:textColor="#A0A0B0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvCustomBlacklistList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Belum ada domain kustom yang diblokir."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <!-- Reset Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomBlacklistClear"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"
                    android:text="Hapus Semua"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
